module Main exposing (main)

import Browser
import File exposing (File)
import File.Select as Select
import Html exposing (Html, button, div, h1, p, pre, text)
import Html.Attributes exposing (style)
import Html.Events exposing (onClick)
import Kronar.ResultFile as ResultFile exposing (GameResult)
import Task
import View.Board as Board
import View.Report as Report
import View.Style as Style



-- Model


type alias Model =
    { result : Maybe GameResult
    , error : Maybe String
    }


init : () -> ( Model, Cmd Msg )
init _ =
    ( { result = Nothing, error = Nothing }, Cmd.none )



-- Update


type Msg
    = PickFile
    | FileSelected File
    | FileLoaded String


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        PickFile ->
            ( model, Select.file [ "application/json", ".json" ] FileSelected )

        FileSelected file ->
            ( model, Task.perform FileLoaded (File.toString file) )

        FileLoaded content ->
            case ResultFile.parse content of
                Ok result ->
                    ( { model | result = Just result, error = Nothing }, Cmd.none )

                Err message ->
                    ( { model | result = Nothing, error = Just message }, Cmd.none )



-- View


view : Model -> Html Msg
view model =
    div
        [ style "font-family" "sans-serif"
        , style "max-width" "900px"
        , style "margin" "0 auto"
        , style "padding" "16px"
        , style "background" "#f6f7f9"
        ]
        [ h1 [] [ text "The Game of the Kronars" ]
        , button [ onClick PickFile ] [ text "Load resultado.json" ]
        , viewError model.error
        , viewResult model.result
        ]


viewError : Maybe String -> Html Msg
viewError error =
    case error of
        Nothing ->
            text ""

        Just message ->
            div (Style.card ++ [ style "border-color" "#c0392b", style "color" "#c0392b" ])
                [ p [] [ text "The file could not be loaded." ]
                , pre [ style "white-space" "pre-wrap" ] [ text message ]
                ]


viewResult : Maybe GameResult -> Html Msg
viewResult maybeResult =
    case maybeResult of
        Nothing ->
            p [] [ text "Choose the resultado.json file generated by Kronar.hs." ]

        Just result ->
            div []
                [ div Style.card
                    [ Board.view
                        { board = result.board
                        , goal = result.goal
                        , marked = result.optimalPath
                        , dravek = Nothing
                        , onSquareClick = Nothing
                        }
                    ]
                , Report.view result
                ]



-- Main


main : Program () Model Msg
main =
    Browser.element
        { init = init
        , update = update
        , subscriptions = \_ -> Sub.none
        , view = view
        }