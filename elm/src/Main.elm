module Main exposing (main)

import Browser
import File exposing (File)
import File.Select as Select
import Html exposing (Html, button, div, h1, p, pre, text)
import Html.Attributes exposing (disabled, style)
import Html.Events exposing (onClick)
import Kronar.ResultFile as ResultFile exposing (GameResult)
import Kronar.Rules as Rules
import Task
import View.Board as Board
import View.Playback as Playback
import View.Player as Player
import View.Report as Report
import View.Style as Style



-- Model


type Mode
    = PlaybackMode
    | PlayerMode


type alias Model =
    { result : Maybe GameResult
    , error : Maybe String
    , mode : Mode
    , step : Int
    , playerPath : List Int
    , playerNote : String
    }


init : () -> ( Model, Cmd Msg )
init _ =
    ( { result = Nothing
      , error = Nothing
      , mode = PlaybackMode
      , step = 0
      , playerPath = [ 0 ]
      , playerNote = ""
      }
    , Cmd.none
    )



-- Update


type Msg
    = PickFile
    | FileSelected File
    | FileLoaded String
    | ChangeMode Mode
    | Previous
    | Next
    | ClickSquare Int
    | ResetPlayer


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        PickFile ->
            ( model, Select.file [ "application/json", ".json" ] FileSelected )

        FileSelected file ->
            ( model, Task.perform FileLoaded (File.toString file) )

        FileLoaded content ->
            case ResultFile.parse content of
                Ok result ->
                    ( { model | result = Just result, error = Nothing, step = 0, playerPath = [ 0 ], playerNote = "" }
                    , Cmd.none
                    )

                Err message ->
                    ( { model | result = Nothing, error = Just message }, Cmd.none )

        ChangeMode mode ->
            ( { model | mode = mode }, Cmd.none )

        Previous ->
            ( { model | step = max 0 (model.step - 1) }, Cmd.none )

        Next ->
            ( { model | step = min (lastStep model) (model.step + 1) }, Cmd.none )

        ClickSquare position ->
            ( clickSquare position model, Cmd.none )

        ResetPlayer ->
            ( { model | playerPath = [ 0 ], playerNote = "" }, Cmd.none )


lastStep : Model -> Int
lastStep model =
    case model.result of
        Just result ->
            List.length result.optimalPath - 1

        Nothing ->
            0


clickSquare : Int -> Model -> Model
clickSquare position model =
    case model.result of
        Nothing ->
            model

        Just result ->
            let
                current =
                    List.head (List.reverse model.playerPath) |> Maybe.withDefault 0
            in
            if current == result.goal then
                { model | playerNote = "You already reached the goal. Press Start again to play another round." }

            else if Rules.isValidJump result.goal current position then
                { model | playerPath = model.playerPath ++ [ position ], playerNote = "" }

            else
                { model | playerNote = rejectReason result.goal current position }


rejectReason : Int -> Int -> Int -> String
rejectReason goal current position =
    if position <= current then
        "Dravek cannot move backward or stay in place."

    else if position > goal then
        "That square is past the goal (square " ++ String.fromInt (goal + 1) ++ ")."

    else
        "Jumps can only be 1, 2 or 3 squares long."



-- View


view : Model -> Html Msg
view model =
    div
        [ style "font-family" "sans-serif"
        , style "max-width" "900px"
        , style "margin" "0 auto"
        , style "padding" "16px"
        , style "background" "#f6f7f9"
        ]
        [ h1 [] [ text "The Game of the Kronars" ]
        , button [ onClick PickFile ] [ text "Load resultado.json" ]
        , viewError model.error
        , viewResult model
        ]


viewError : Maybe String -> Html Msg
viewError error =
    case error of
        Nothing ->
            text ""

        Just message ->
            div (Style.card ++ [ style "border-color" "#c0392b", style "color" "#c0392b" ])
                [ p [] [ text "The file could not be loaded." ]
                , pre [ style "white-space" "pre-wrap" ] [ text message ]
                ]


viewResult : Model -> Html Msg
viewResult model =
    case model.result of
        Nothing ->
            p [] [ text "Choose the resultado.json file generated by Kronar.hs." ]

        Just result ->
            div []
                [ div Style.card [ viewBoard model result ]
                , modeButtons model.mode
                , viewMode model result
                , Report.view result
                ]


viewBoard : Model -> GameResult -> Html Msg
viewBoard model result =
    case model.mode of
        PlaybackMode ->
            Board.view
                { board = result.board
                , goal = result.goal
                , marked = result.optimalPath
                , dravek = List.head (List.drop model.step result.optimalPath)
                , onSquareClick = Nothing
                }

        PlayerMode ->
            Board.view
                { board = result.board
                , goal = result.goal
                , marked = model.playerPath
                , dravek = List.head (List.reverse model.playerPath)
                , onSquareClick = Just ClickSquare
                }


modeButtons : Mode -> Html Msg
modeButtons mode =
    div []
        [ button [ onClick (ChangeMode PlaybackMode), disabled (mode == PlaybackMode) ] [ text "Step-by-step playback" ]
        , text " "
        , button [ onClick (ChangeMode PlayerMode), disabled (mode == PlayerMode) ] [ text "Player mode" ]
        ]


viewMode : Model -> GameResult -> Html Msg
viewMode model result =
    case model.mode of
        PlaybackMode ->
            Playback.view result model.step Previous Next

        PlayerMode ->
            Player.view result model.playerPath model.playerNote ResetPlayer



-- Main


main : Program () Model Msg
main =
    Browser.element
        { init = init
        , update = update
        , subscriptions = \_ -> Sub.none
        , view = view
        }
